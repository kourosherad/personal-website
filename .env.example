# Copy to .env (locally) or set these in your host's dashboard (Vercel/Netlify).
# Used by the /api/contact serverless function.

# Resend API key — create at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered
CONTACT_TO_EMAIL=you@example.com

# A verified sender address on your Resend domain
CONTACT_FROM_EMAIL=site@yourdomain.com
